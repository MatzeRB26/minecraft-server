# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# The .env file is ignored by git - never commit real secrets.

# Accept the Minecraft EULA (https://www.minecraft.net/eula).
# The server only starts if this is set to true.
EULA=false

# Password for RCON (remote console). Leave empty to disable RCON.
RCON_PASSWORD=<YOUR_RCON_PASSWORD>

# Public port of the Minecraft server on the host (default: 8888)
# MC_PORT=8888
