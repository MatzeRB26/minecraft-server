# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# The .env file is ignored by git - never commit real secrets.

# Password for RCON (remote console). Leave empty to disable RCON.
RCON_PASSWORD=<YOUR_RCON_PASSWORD>

# Your Minecraft username, gets operator (admin) rights. Leave empty for none.
OPS=<YOUR_MINECRAFT_USERNAME>
